# Faisal Hanif portfolio API: environment variables
#
# Copy this file to backend/.env and fill in what you need. Never commit backend/.env.
# Empty values count as unset. Real environment variables always win over this file.
# Every key is optional so the server can boot before you add them. A feature whose
# keys are missing answers 503 and the site falls back to its built in behaviour.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# development, test or production.
NODE_ENV=development

# Address the API listens on. Keep 127.0.0.1 behind nginx on the VPS.
HOST=127.0.0.1

# Port the API listens on (nginx proxies /api to it).
PORT=8787

# fatal, error, warn, info, debug, trace or silent (silent is the default in tests).
LOG_LEVEL=info

# Express "trust proxy" setting: the number of proxies in front of the API (1 for nginx),
# true, false, or a list of trusted addresses. Rate limits use it to see the real visitor IP.
TRUST_PROXY=1

# Public address of the website, used in email links.
SITE_URL=https://faisalhanif.work

# Public address of this API, used for the meeting join links in the booking emails
# (<API_PUBLIC_URL>/api/join/<token>). Leave empty to use SITE_URL (right when nginx serves /api on
# the site's own domain). For local tests set it to http://localhost:8787.
API_PUBLIC_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma separated list of site origins allowed to call the API (scheme, host and port,
# no path). Required in production, for example https://faisalhanif.work
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Chat (OpenRouter)
# ---------------------------------------------------------------------------

# Secret API key from https://openrouter.ai/keys. Chat is off until this and the model are set.
OPENROUTER_API_KEY=

# Model id copied from https://openrouter.ai/models, in the form provider/model-name.
OPENROUTER_MODEL=

# Optional comma separated model ids that OpenRouter tries when the main model fails.
OPENROUTER_FALLBACK_MODELS=

# Maximum tokens in one chat reply (50 to 4000).
CHAT_MAX_TOKENS=600

# Maximum chat messages per day across all visitors, to protect the OpenRouter budget.
CHAT_DAILY_GLOBAL_LIMIT=1000

# ---------------------------------------------------------------------------
# Mail (SMTP, Gmail by default; any SMTP host works by changing these values)
# ---------------------------------------------------------------------------

# SMTP server host.
SMTP_HOST=smtp.gmail.com

# SMTP port: 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465

# true for an implicit TLS connection (port 465), false for STARTTLS (port 587).
SMTP_SECURE=true

# SMTP login. For Gmail this is your Gmail address.
SMTP_USER=

# SMTP password. For Gmail create an App Password at https://myaccount.google.com/apppasswords
# (it needs 2-Step Verification turned on first). Your normal Gmail password will not work.
SMTP_PASS=

# Sender shown on every email. Defaults to "Faisal Hanif <SMTP_USER>" when left empty.
MAIL_FROM=

# Inbox that receives contact messages and booking notices.
MAIL_TO_OWNER=

# ---------------------------------------------------------------------------
# Google Calendar and Google Meet (booking)
# ---------------------------------------------------------------------------

# OAuth client id from Google Cloud Console > APIs and Services > Credentials
# (enable the Google Calendar API first).
GOOGLE_CLIENT_ID=

# OAuth client secret from the same OAuth client.
GOOGLE_CLIENT_SECRET=

# Refresh token for your Google account. Run `npm run google:auth` and paste what it prints.
GOOGLE_REFRESH_TOKEN=

# Calendar that receives bookings. "primary" is your main Google Calendar.
GOOGLE_CALENDAR_ID=primary

# ---------------------------------------------------------------------------
# Booking
# ---------------------------------------------------------------------------

# IANA time zone of the owner's working hours (Mon to Fri, slots 09:00 to 17:00).
BOOKING_TIMEZONE=Asia/Karachi

# Secret that seals the meeting join links in the booking emails. The links open the real Google
# Meet address only from 10 minutes before the session until 15 minutes after it should
# end. Leave empty to use the Google client secret (or SMTP password) as the key. Set a long random
# value to keep the links valid even if those change. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JOIN_LINK_SECRET=

# ---------------------------------------------------------------------------
# Dev
# ---------------------------------------------------------------------------

# true replaces OpenRouter, SMTP and Google Calendar with local fakes (mail goes to tmp/mail).
# Refused when NODE_ENV=production. `npm run dev:fake` sets it for you.
DEV_FAKE_EXTERNALS=false
