# ─── OpenRouter API Configuration (AI chat assistant) ────────────────────────
# Create a key at https://openrouter.ai (Settings → API Keys)
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# Primary model (defaults to google/gemini-3.8-flash if not set)
OPENROUTER_MODEL=google/gemini-3.8-flash

# Comma-separated backup models, tried in order if the primary fails (max 2)
OPENROUTER_FALLBACK_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite

# Optional — defaults shown
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# SITE_URL=https://faisalhanif.work
# SITE_NAME=Faisal Hanif Portfolio

# ─── Chat Rate Limits (optional — defaults shown) ─────────────────────────────
# CHAT_BURST_LIMIT=3            # messages per minute per visitor IP
# CHAT_DAILY_LIMIT=10           # messages per day per visitor IP
# CHAT_GLOBAL_DAILY_LIMIT=500   # messages per day for the whole site (caps OpenRouter spend)
# TRUST_PROXY=loopback          # use "2" if a CDN like Cloudflare sits in front of nginx

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Email Configuration (for booking confirmation emails) ────────────────────
# Gmail address that sends and receives booking notifications
EMAIL_USER=mehrfaisal111@gmail.com

# Gmail App Password (NOT your regular Gmail password!)
# How to get one:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Go to myaccount.google.com → Security → App passwords
#   3. Select "Mail" and your device, click Generate
#   4. Copy the 16-character password shown and paste it below (no spaces)
EMAIL_PASS=your-16-char-app-password-here
