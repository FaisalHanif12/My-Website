# OpenRouter API Configuration
# Copy this file to .env and fill in your actual values
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openai/gpt-4o-mini

# Server Configuration
PORT=3000
NODE_ENV=production

# ─── Email Configuration (for booking confirmation emails) ───────────────────
# Gmail address that sends and receives booking notifications
EMAIL_USER=mehrfaisal111@gmail.com

# Gmail App Password (NOT your regular Gmail password!)
# How to get one:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Go to myaccount.google.com → Security → App passwords
#   3. Select "Mail" and your device, click Generate
#   4. Copy the 16-character password shown and paste it below (no spaces)
EMAIL_PASS=your-16-char-app-password-here

