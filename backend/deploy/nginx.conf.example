# nginx site for faisalhanif.work: the Next.js app on 127.0.0.1:3000 and the API on 127.0.0.1:8787.
# Copy to /etc/nginx/sites-available/faisalhanif.work, link it into sites-enabled, then
#   sudo nginx -t && sudo systemctl reload nginx
# Get the certificate first with:  sudo certbot --nginx -d faisalhanif.work -d www.faisalhanif.work

server {
    listen 80;
    server_name faisalhanif.work www.faisalhanif.work;
    return 301 https://faisalhanif.work$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.faisalhanif.work;
    ssl_certificate     /etc/letsencrypt/live/faisalhanif.work/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/faisalhanif.work/privkey.pem;
    return 301 https://faisalhanif.work$request_uri;
}

server {
    listen 443 ssl http2;
    server_name faisalhanif.work;

    ssl_certificate     /etc/letsencrypt/live/faisalhanif.work/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/faisalhanif.work/privkey.pem;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # The API. The client IP is passed on so the per IP rate limits see real visitors
    # (the API runs with TRUST_PROXY=1, one proxy in front).
    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        client_max_body_size 64k;
        # The chat can stream (?stream=true): send pieces as they come.
        proxy_buffering off;
    }

    # The site.
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Hashed build files never change: cache them for a year.
    location /_next/static/ {
        proxy_pass http://127.0.0.1:3000;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
}
